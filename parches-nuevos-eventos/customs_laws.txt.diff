--- (archivo nuevo)
+++ corregido/events/customs_laws.txt
@@ -0,0 +1,106 @@
+namespace = customs_laws
+
+# on action every month
+customs_laws.1 = {
+	type = country_event
+	placement = ROOT
+
+	title = customs_laws.1.t
+	desc = customs_laws.1.d
+	flavor = customs_laws.1.f
+
+	cooldown = { years = 999 }
+	duration = 1
+
+	event_image = {
+		video = "gfx/event_pictures/unspecific_politicians_arguing.bk2"
+	}
+
+	on_created_soundeffect = "event:/SFX/UI/Alerts/event_appear"
+	icon = "gfx/interface/icons/event_icons/event_trade.dds"
+
+	trigger = {
+		c:ARG ?= this # important because c:ARG can not exist
+		game_date >= 1836.4.1 #first day
+	}
+
+	immediate = {
+
+
+
+
+		every_scope_state = {
+			limit = {
+				owner = root
+				NOT = {
+					state_region = s:STATE_BUENOS_AIRES
+				}
+			} add_modifier = {
+				name = customs_laws3
+			}
+		}
+
+
+	}
+
+	option = {
+		name = customs_laws.1.a
+		default_option = yes
+		custom_tooltip = customs_laws_tip
+
+		add_modifier = { name = customs_laws }
+
+		every_state = {
+			limit = {
+				owner = root
+				state_region = s:STATE_BUENOS_AIRES
+			} add_modifier = {
+				name = customs_laws2
+			}
+		}
+	}
+	}
+
+# on action every month
+customs_laws.2 = {
+	type = country_event
+	placement = ROOT
+	hidden = yes
+
+	trigger = {
+		c:ARG ?= this # important because c:ARG can not exist
+		has_modifier = customs_laws
+		NOT = {
+			# initial economic law
+			has_law = law_type:law_mercantilism
+		}
+	}
+
+	immediate = {
+		remove_modifier = customs_laws
+
+		every_state = {
+			limit = {
+				owner = root
+				state_region = s:STATE_BUENOS_AIRES
+			} remove_modifier =
+				customs_laws2
+
+		}
+
+		every_state = {
+			limit = {
+				owner = root
+				NOT = {
+					state_region = s:STATE_BUENOS_AIRES
+				}
+			} remove_modifier =
+				customs_laws3
+
+		}
+	}
+}
+
+
+
